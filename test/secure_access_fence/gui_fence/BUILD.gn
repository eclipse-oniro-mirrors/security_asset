module_output_path = "asset/asset"

ohos_unittest("saf_gui_cache_manager_test") {
  module_out_path = module_output_path
  subsystem_name = "security"
  part_name = "asset"

  include_dirs = [
    "../../../frameworks/secure_access_fence/inner_api/gui_fence/inc",
  ]

  sources = [
    "src/gui_cache_manager_test.cpp",
    "../../../frameworks/secure_access_fence/inner_api/gui_fence/src/gui_cache_manager.cpp",
  ]
  
  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "googletest:gtest_main"
  ]

  branch_protector_ret = "pac_ret"
  sanitize = {
    integer_overflow = true
    cfi = true
    debug = false
    cfi_cross_dso = true
    boundary_sanitize = true
    ubsan = true
  }
}

