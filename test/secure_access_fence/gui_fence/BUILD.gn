# Unit test for the gui_fence internal helpers (ParseDeniedPair, HandleIpcError)
# extracted into gui_fence_inner_helper.{h,cpp}. The helper .cpp is compiled
# directly into this test target (it has no global state and no dependency on
# SAMGR/IPC runtime beyond the ISecureAccessFence type declaration provided by
# the IDL-generated header) so the test does not need to export those symbols
# from the saf_gui_fence shared library's version_script.
ohos_unittest("saf_gui_fence_parse_test") {
  module_out_path = module_output_path
  subsystem_name = "security"
  part_name = "asset"

  include_dirs = [
    "../../../frameworks/secure_access_fence/inner_api/gui_fence/inc",
    "../../../interfaces/inner_kits/c/secure_access_fence/gui_fence/inc",
    "../../../interfaces/inner_kits/c/secure_access_fence/common/inc",
    "../../../frameworks/secure_access_fence/os_dependency/log/inc",
  ]

  sources = [
    "src/saf_gui_fence_parse_test.cpp",
    "../../../frameworks/secure_access_fence/inner_api/gui_fence/src/gui_fence_inner_helper.cpp",
  ]

  deps = [
    "../../../frameworks/secure_access_fence/inner_api/ipc:secure_access_fence_proxy",
  ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "samgr:samgr_proxy",
    "bounds_checking_function:libsec_shared",
    "googletest:gtest_main",
  ]

  branch_protector_ret = "pac_ret"
  sanitize = {
    integer_overflow = true
    cfi = true
    debug = false
    cfi_cross_dso = true
    boundary_sanitize = true
    ubsan = true
  }
}
