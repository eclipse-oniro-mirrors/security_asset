import("//build/ohos.gni")
import("//build/test.gni")
import("//base/security/asset/config.gni")

module_output_path = "asset/asset"

# Functional + authorization tests for the 26.2.0 SafCredential inner API.
# Two test binaries:
#   - saf_credential_test: 18 functional cases. SetUpTestCase grants
#     ACCESS_SECURE_FENCE + system_basic APL so the service's auth check
#     passes when it is deployed.
#   - saf_credential_permission_test: 4 authorization cases. SetUpTestCase
#     sets an APL_NORMAL token with no permissions to exercise the
#     no-permission paths.
#
# Both binaries auto-detect whether SA 66532 is deployed (probe) and adjust
# assertions accordingly, so they can run in both no-SA
# (SERVICE_UNAVAILABLE expected) and SA-deployed (SUCCESS or auth codes
# expected) environments.

ohos_unittest("saf_credential_test") {
  module_out_path = module_output_path
  subsystem_name = "security"
  part_name = "asset"
  testonly = true

  include_dirs = [
    "inc",
    "../../../interfaces/inner_kits/c/secure_access_fence/credential/inc",
    "../../../interfaces/inner_kits/c/secure_access_fence/common/inc",
    "../../../frameworks/secure_access_fence/os_dependency/log/inc",
  ]

  sources = [
    "src/saf_credential_permission_helper.cpp",
    "src/saf_credential_test.cpp",
  ]

  deps = [
    "../../../interfaces/inner_kits/c/secure_access_fence/credential:saf_credential",
  ]

  external_deps = [
    "access_token:libnativetoken_shared",
    "access_token:libtokensetproc_shared",
    "c_utils:utils",
    "hilog:libhilog",
  ]

  branch_protector_ret = "pac_ret"
  sanitize = {
    integer_overflow = true
    cfi = true
    debug = false
    cfi_cross_dso = true
    boundary_sanitize = true
    ubsan = true
  }
}

ohos_unittest("saf_credential_permission_test") {
  module_out_path = module_output_path
  subsystem_name = "security"
  part_name = "asset"
  testonly = true

  include_dirs = [
    "inc",
    "../../../interfaces/inner_kits/c/secure_access_fence/credential/inc",
    "../../../interfaces/inner_kits/c/secure_access_fence/common/inc",
    "../../../frameworks/secure_access_fence/os_dependency/log/inc",
  ]

  sources = [
    "src/saf_credential_permission_test.cpp",
  ]

  deps = [
    "../../../interfaces/inner_kits/c/secure_access_fence/credential:saf_credential",
  ]

  external_deps = [
    "access_token:libnativetoken_shared",
    "access_token:libtokensetproc_shared",
    "c_utils:utils",
    "hilog:libhilog",
  ]

  branch_protector_ret = "pac_ret"
  sanitize = {
    integer_overflow = true
    cfi = true
    debug = false
    cfi_cross_dso = true
    boundary_sanitize = true
    ubsan = true
  }
}
