import("//build/ohos.gni")
import("//build/test.gni")
import("//base/security/asset/config.gni")

module_output_path = "asset/asset"

# Functional + authorization tests for the 26.2.0 SafCredential inner API.
# Two test binaries:
#   - saf_credential_test: 20 functional cases covering all 10 inner APIs.
#     SetUpTestCase grants ACCESS_SECURE_FENCE + system_basic APL so the
#     service's auth check passes when it is deployed.
#   - saf_credential_permission_test: 10 authorization cases, one per inner
#     API. SetUpTestCase sets an APL_NORMAL token with no permissions to
#     exercise the no-permission paths.
#
# Both binaries auto-detect whether SA 66532 is deployed (probe) and adjust
# assertions accordingly, so they can run in both no-SA
# (SERVICE_UNAVAILABLE expected) and SA-deployed (SUCCESS or auth codes
# expected) environments.

ohos_unittest("saf_credential_test") {
  module_out_path = module_output_path
  subsystem_name = "security"
  part_name = "asset"
  testonly = true

  include_dirs = [
    "inc",
    "../../../interfaces/inner_kits/c/secure_access_fence/credential/inc",
    "../../../interfaces/inner_kits/c/secure_access_fence/common/inc",
    "../../../frameworks/secure_access_fence/os_dependency/log/inc",
  ]

  sources = [
    "src/saf_credential_permission_helper.cpp",
    "src/saf_credential_test.cpp",
  ]

  deps = [
    "../../../interfaces/inner_kits/c/secure_access_fence/credential:saf_credential",
  ]

  external_deps = [
    "access_token:libnativetoken_shared",
    "access_token:libtokensetproc_shared",
    "c_utils:utils",
    "hilog:libhilog",
  ]

  branch_protector_ret = "pac_ret"
  sanitize = {
    integer_overflow = true
    cfi = true
    debug = false
    cfi_cross_dso = true
    boundary_sanitize = true
    ubsan = true
  }
}

# Pure unit tests for the client-side credential helpers. No system ability,
# no samgr, no IPC runtime: credential_inner_helper.cpp is compiled directly
# into this binary, so the cases run in every environment including CI images
# where SA 66532 is not deployed.
ohos_unittest("saf_credential_inner_helper_test") {
  module_out_path = module_output_path
  subsystem_name = "security"
  part_name = "asset"
  testonly = true

  include_dirs = [
    "inc",
    "../../../interfaces/inner_kits/c/secure_access_fence/credential/inc",
    "../../../interfaces/inner_kits/c/secure_access_fence/common/inc",
    "../../../frameworks/secure_access_fence/inner_api/credential/inc",
    "../../../frameworks/secure_access_fence/os_dependency/log/inc",
  ]

  sources = [
    "src/saf_credential_inner_helper_test.cpp",
    "../../../frameworks/secure_access_fence/inner_api/credential/src/credential_inner_helper.cpp",
  ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
  ]

  branch_protector_ret = "pac_ret"
  sanitize = {
    integer_overflow = true
    cfi = true
    debug = false
    cfi_cross_dso = true
    boundary_sanitize = true
    ubsan = true
  }
}

