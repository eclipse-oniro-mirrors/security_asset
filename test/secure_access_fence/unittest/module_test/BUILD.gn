import("//build/test.gni")

ohos_unittest("saf_dependency_test") {
  module_out_path = "asset/asset"
  subsystem_name = "security"
  part_name = "asset"

  include_dirs = [ "../../../../services/secure_access_fence/os_dependency/inc" ]
  sources = [ "src/memory_manager_wrapper_test.cpp" ]

  deps = [
    "../../../../services/secure_access_fence/os_dependency:saf_os_dependency",
  ]

  external_deps = [
    "hilog:libhilog",
    "ipc:ipc_single",
    "memmgr:memmgrclient",
    "samgr:samgr_proxy",
    "googletest:gtest_main"
  ]

  branch_protector_ret = "pac_ret"
  sanitize = {
    integer_overflow = true
    cfi = true
    debug = false
    cfi_cross_dso = true
    boundary_sanitize = true
    ubsan = true
  }
}
