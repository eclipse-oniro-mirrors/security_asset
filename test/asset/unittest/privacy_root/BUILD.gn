import("//build/test.gni")
import("//build/ohos.gni")

ohos_unittest("asset_privacy_root_test") {
  module_out_path = "asset/privacy_computation"
  sources = [
    "src/huks_seed_deriver_test.cpp",
    "../../../../services/asset/privacy/src/huks_seed_deriver.cpp",
  ]
  include_dirs = [
    "../../../../services/asset/privacy/inc",
    "../../../../psi_pir_protocol/common/inc",
    "../../../../psi_pir_protocol/he/inc",
    "../../../../psi_pir_protocol/protocol/inc",
  ]
  deps = [ "../../../../psi_pir_protocol:psi_pir_protocol" ]
  external_deps = [
    "huks:libhukssdk",
    "hilog:libhilog",
    "openssl:libcrypto_shared",
    "googletest:gtest_main",
  ]
  cflags_cc = [
    "-std=c++17",
    "-Wall",
    "-Wextra",
    "-Werror",
  ]
  subsystem_name = "security"
  part_name = "asset"
}
