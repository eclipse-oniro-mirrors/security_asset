import("//build/ohos.gni")
ohos_static_library("asset_privacy") {
  sources = [
    "src/privacy_service.cpp",
    "src/huks_seed_deriver.cpp",
  ]
  include_dirs = [
    "inc",
    "../../../frameworks/privacy_computation/ipc/inc",
    "../../../privacy_protocol/he/inc",
    "../../../privacy_protocol/common/inc",
    "../../../privacy_protocol/protocol/inc",
  ]
  deps = [ "../../../privacy_protocol:privacy_protocol" ]
  external_deps = [
    "bounds_checking_function:libsec_shared",
    "c_utils:utils",
    "hilog:libhilog",
    "huks:libhukssdk",
    "ipc:ipc_single",
    "os_account:os_account_innerkits",
  ]
  cflags_cc = [
    "-std=c++17",
    "-Wall",
    "-Werror",
    "-fPIC",
  ]
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  subsystem_name = "security"
  part_name = "asset"
}
