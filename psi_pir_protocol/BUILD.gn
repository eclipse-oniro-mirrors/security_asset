import("//build/ohos.gni")
import("//build/test.gni")

config("psi_pir_protocol_public_config") {
  include_dirs = [ "include" ]
}

# Internal module headers are visible only to psi_pir_protocol and its unit tests.
psi_pir_protocol_internal_include_dirs = [
  "common/inc",
  "crypto/inc",
  "protocol/inc",
  "core/inc",
  "he/inc",
]

ohos_static_library("psi_pir_protocol") {
  public_configs = [ ":psi_pir_protocol_public_config" ]

  include_dirs = psi_pir_protocol_internal_include_dirs

  sources = [
    "common/src/provider_registry.cpp",
    "core/src/psi_pir_protocol_impl.cpp",
    "crypto/src/openssl_crypto_provider.cpp",
    "he/src/he_key_deriver.cpp",
    "he/src/hifhe_adapter.cpp",
    "he/src/soft_he_engine.cpp",
    "protocol/src/protocol_codec.cpp",
    "protocol/src/protocol_encoder.cpp",
    "protocol/src/protocol_mapper.cpp",
    "src/psi_pir_protocol.cpp",
  ]

  external_deps = [
    "bounds_checking_function:libsec_shared",
    "hilog:libhilog",
    "hifhe:libhifhe",
    "openhitls:openhitls_bsl",
    "openhitls:openhitls_crypto",
    "openssl:libcrypto_shared",
  ]

  cflags_cc = [
    "-std=c++17",
    "-Wall",
    "-Werror",
    "-fPIC",
    "-fno-exceptions",
  ]

  branch_protector_ret = "pac_ret"
  sanitize = {
    integer_overflow = true
    cfi = true
    debug = false
    cfi_cross_dso = true
    boundary_sanitize = true
    ubsan = true
  }

  subsystem_name = "security"
  part_name = "asset"
}

ohos_unittest("psi_pir_protocol_test") {
  module_out_path = "asset/asset"

  sources = [ "tests/psi_pir_protocol_test.cpp" ]

  include_dirs = psi_pir_protocol_internal_include_dirs

  deps = [ ":psi_pir_protocol" ]

  external_deps = [ "hilog:libhilog" ]

  cflags_cc = [
    "-std=c++17",
    "-Wall",
    "-Werror",
    "-fno-exceptions",
  ]

  branch_protector_ret = "pac_ret"
  sanitize = {
    integer_overflow = true
    cfi = true
    debug = false
    cfi_cross_dso = true
    boundary_sanitize = true
    ubsan = true
  }

  subsystem_name = "security"
  part_name = "asset"
}

# HE integration tests share the same library and provider registry as protocol tests.
ohos_unittest("psi_pir_he_test") {
  module_out_path = "asset/hpic"
  sources = [ "tests/psi_pir_he_test.cpp" ]
  include_dirs = psi_pir_protocol_internal_include_dirs
  deps = [ ":psi_pir_protocol" ]
  external_deps = [
    "hilog:libhilog",
    "openssl:libcrypto_shared",
    "hifhe:libhifhe",
    "openhitls:openhitls_bsl",
    "openhitls:openhitls_crypto",
    "googletest:gtest_main"
  ]
  cflags_cc = [
    "-std=c++17",
    "-Wall",
    "-Werror",
  ]
  subsystem_name = "security"
  part_name = "asset"
}
