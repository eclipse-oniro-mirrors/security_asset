package OHOS.Security.SAF;

/**
 * @brief CommandInfo structure for permission query.
 */
struct CommandInfo {
    /** Command name identifier. */
    String cmdName;
    /** Sub-command identifier. */
    String subCmd;
};

/**
 * @brief Command permission result structure.
 */
struct CommandPermissionInfo {
    /** Command that was queried. */
    CommandInfo cmd;
    /** List of permissions associated with the command. */
    List<String> permissions;
    /** Result of get permission of command. */
    int queryRet;
};

/**
 * @brief Verify ticket info structure for ticket generation and verification.
 */
struct VerifyTicketInfo {
    /** Message for ticket. */
    String message;
    /** Challenge string. */
    String challenge;
    /** Ticket string. */
    String ticket;
};

/**
 * @brief CLI info structure for ticket verification output.
 */
struct CliInfo {
    /** Caller token ID. */
    String callerTokenId;
    /** CLI command name. */
    String cliCmdName;
    /** Sub CLI command name. */
    String subCliCmdName;
    /** Permission list for the CLI command. */
    List<String> permissionList;
};

enum OperationType {
    CLI = 1,
    API = 2
};

struct OperationInfo {
    OperationType operationType;
    CommandInfo cliCmdInfo;
    String permission;
};

enum PermissionStatus {
    DENIED = -1,
    GRANTED = 0,
    NOT_DETERMINED = 1,
    INVALID = 2,
    RESTRICTED = 3
};

enum PolicyStatus {
    NOT_EXIST = -1,
    REQUIRE_AUTH = 0,
    FORBIDDEN = 1,
    AUTHORIZED = 2,
    RESTRICTED = 3,
    REMOTE_RESTRICTED = 4
};

enum AuthStatus {
    REQUIRE_AUTH = 0,
    FORBIDDEN = 1,
    AUTHORIZED = 2,
    RESTRICTED = 3,
    REMOTE_RESTRICTED = 4
};

enum Role {
    CONTROLLER = 1,
    CONTROLLED = 2
};

struct AuthStatusInfo {
    AuthStatus authStatus;
    int flag;
};

struct PermissionInfo {
    String permission;
    PermissionStatus permissionStatus;
    AuthStatusInfo authStatusInfo;
};

struct PermissionQueryResult {
    boolean needDialog;
    List<PermissionInfo> permissionResults;
    boolean hasTicket;
    VerifyTicketInfo ticket;
};

struct RemoteControlParams {
    String challenge;
    String remoteControlTicket;
    String controlledDeviceName;
    String controllerDeviceName;
    String signVerifyMsg;
};

struct RemoteInfo {
    Role role;
    String remoteId;
    String domainId;
    RemoteControlParams remoteControlParams;
};

/**
 * @brief Task identity generated for task-level authorization.
 */
struct TaskIdentity {
    /** Serialized task attributes JSON. */
    String taskAttributes;
    /** Signed identity of the task. */
    String identity;
    /** Challenge bound to the task (empty for low-risk tasks). */
    String challenge;
};

struct PermissionQuery {
    List<OperationInfo> operationInfo;
    boolean needTicket;
    int ticketExpireTimeMs;
    int callerTokenId;
    String domainId;
    RemoteInfo remoteInfo;
    TaskIdentity taskIdentity;
};

/**
 * @brief Task execution type.
 */
enum ExecuteType {
    /** Instant execution. */
    INSTANT = 1,
    /** Delayed execution. */
    DELAYED = 2
};

/**
 * @brief Task identity info for task-level authorization.
 */
struct TaskIdentityInfo {
    /** Task ID. */
    String taskId;
    /** Task expiration time in absolute epoch seconds. */
    int taskExpireTime;
    /** Task execution type. */
    ExecuteType executeType;
    /** Whether the task is allowed to execute while the screen is locked. */
    boolean allowScreenLockExecution;
    /** Allowable duration for delayed execution. */
    int allowableDuration;
    /** IAM auth token bytes; empty when no authentication is required. */
    List<int> authToken;
};

struct UserAuthResult {
    List<PermissionInfo> permissionInfo;
    PermissionQuery permissionQuery;
};

struct RemoteAuthPackage {
    String remoteMessage;
    String challenge;
    String ticket;
};

/**
 * @brief Remote user authentication item for controller device.
 */
struct RemoteUserAuthItem {
    /** Permission string. */
    String permission;
    /** Authentication result string. */
    String authResult;
};

/**
 * @brief Remote user authentication results for controller device.
 */
struct RemoteUserAuthResults {
    /** List of authentication result items. */
    List<RemoteUserAuthItem> results;
    /** Permission query associated with the authentication. */
    PermissionQuery permissionQuery;
};

/**
 * @brief Remote grant status enum.
 */
enum RemoteGrantStatus {
    /** Enable remote grant. */
    ENABLE = 1,
    /** Disable remote grant. */
    DISABLE = 2
};

/**
 * @brief Ticket options for requestToolTicket.
 */
struct TicketOptions {
    /** Ticket expire time in milliseconds. NAPI defaults to 10000 if not provided. Max 60000ms. */
    int ticketExpireTimeMs;
};

/**
 * @brief Result of requestToolTicket.
 */
struct TicketQueryResult {
    /** Permission query results (filtered: only unauthorized on error). */
    List<PermissionInfo> permissionResults;
    /** Ticket string (JSON wrapped). Empty if not generated. */
    String ticket;
};

/**
 * @brief Application information for simulated click control.
 */
struct AppInfo {
    /** Bundle name of the application. */
    String bundleName;
    /** Application index, used to distinguish cloned applications with the same bundle name. */
    int index;
};

/**
 * @brief Control status of simulated click operation.
 */
enum ControlAppStatus {
    /** The caller application is allowed to control the target application. */
    ALLOW = 1,
    /** The caller application is denied to control the target application. */
    DENY = 2
};

/**
 * @brief Control status result of a target application.
 */
struct ControlAppStatusResult {
    /** Target application information. */
    AppInfo appInfo;
    /** Control status of the caller application over the target application. */
    ControlAppStatus status;
};

/**
 * @brief Control decision enum for whether A app can control B app.
 */
enum ControlDecision {
    /** Allow A app to control B app. */
    ALLOW = 0,
    /** Deny A app to control B app. */
    DENY = 1
};

/**
 * @brief Component click decision result.
 */
struct ComponentClickResult {
    /** Component ID. */
    String compId;
    /** Whether the click is allowed. */
    boolean allowed;
    /** Reason for the decision. */
    String reason;
};
