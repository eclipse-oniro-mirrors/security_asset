import SecureAccessFenceType;

sequenceable OHOS.IRemoteObject;

interface OHOS.Security.SAF.ISecureAccessFence {
    /**
     * @brief Batch generate tickets.
     * @param osAccountId OS account ID.
     * @param callerId Caller identifier (appIdentifyId).
     * @param messages List of messages to generate tickets for.
     * @param ticketInfos List of generated ticket info (output parameter).
     * @param resultCode Error code output (0 for success).
     */
    [ipccode 1] void BatchGenerateTicket(
        [in] int osAccountId,
        [in] String callerId,
        [in] List<String> messages,
        [out] List<VerifyTicketInfo> ticketInfos,
        [out] int resultCode
    );

    /**
     * @brief Batch verify tickets.
     * @param osAccountId OS account ID.
     * @param callerId Caller identifier (appIdentifyId).
     * @param verifyInfos List of verify ticket info to verify.
     * @param verifyRes List of verify results (output parameter).
     * @param resultCode Error code output (0 for success).
     */
    [ipccode 2] void BatchVerifyTicket(
        [in] int osAccountId,
        [in] String callerId,
        [in] List<VerifyTicketInfo> verifyInfos,
        [out] List<int> verifyRes,
        [out] int resultCode
    );

    [ipccode 3] void VerifyTicket(
        [in] int osAccountId,
        [in] String callerId,
        [in] String verifyInfo,
        [out] List<CliInfo> cliInfos,
        [out] int resultCode
    );

    /**
     * @brief Generate controlled device packages for remote control scenario.
     * @param permissionQuery List of permission queries.
     * @param remoteAuthPackage List of generated remote auth packages (output parameter).
     */
    [ipccode 4] void GenerateControlledDevicePackage(
        [in] List<PermissionQuery> permissionQuery,
        [out] List<RemoteAuthPackage> remoteAuthPackage,
        [out] int resultCode
    );

    /**
     * @brief Verify controlled device packages for remote control scenario.
     * @param ticketInfo List of remote auth packages to verify.
     * @param verifyRes List of verification results (output parameter).
     * @param resultCode Error code output (0 for success).
     */
    [ipccode 5] void VerifyControlledDevicePackage(
        [in] List<RemoteAuthPackage> ticketInfo,
        [out] List<boolean> verifyRes,
        [out] int resultCode
    );
    
    /**
     * @brief Generate controller device packages for remote control scenario.
     * @param remoteUserAuthResults List of remote user authentication results.
     * @param remoteAuthPackage List of generated remote auth packages (output parameter).
     * @param resultCode Error code output (0 for success).
     */
    [ipccode 6] void GenerateControllerDevicePackage(
        [in] List<RemoteUserAuthResults> remoteUserAuthResults,
        [out] List<RemoteAuthPackage> remoteAuthPackage,
        [out] int resultCode
    );

    /**
     * @brief Verify controller device packages for remote control scenario.
     * @param ticketInfo List of remote auth packages to verify.
     * @param remoteInfo Remote information for verification.
     * @param verifyRes List of verification results (output parameter).
     * @param resultCode Error code output (0 for success).
     */
    [ipccode 7] void VerifyControllerDevicePackage(
        [in] List<RemoteAuthPackage> ticketInfo,
        [in] RemoteInfo remoteInfo,
        [out] List<boolean> verifyRes,
        [out] int resultCode
    );

    /**
     * @brief Get remote grant status.
     * @param remoteGrantStatus Output remote grant status.
     * @param resultCode Error code output (0 for success).
     */
    [ipccode 8] void GetRemoteGrantStatus(
        [out] int remoteGrantStatus,
        [out] int resultCode
    );

    /**
     * @brief Update remote grant status.
     * @param remoteGrantStatus Remote grant status to set.
     * @param resultCode Error code output (0 for success).
     */
    [ipccode 9] void UpdateRemoteGrantStatus(
        [in] int remoteGrantStatus,
        [out] int resultCode
    );

    
    /**
     * @brief Generate a random challenge for task-level authorization.
     * @param taskIdentityInfo Task identity info.
     * @param challenge Output random challenge bytes.
     * @param resultCode Error code output (0 for success).
     */
    [ipccode 12] void GenerateTaskChallenge(
        [in] TaskIdentityInfo taskIdentityInfo,
        [out] List<int> challenge,
        [out] int resultCode
    );

    /**
     * @brief Generate a task identity for task-level authorization.
     * @param taskIdentityInfo Task identity info (may carry an auth token).
     * @param taskIdentity Output generated task identity.
     * @param resultCode Error code output (0 for success).
     */
    [ipccode 13] void GenerateTaskIdentity(
        [in] TaskIdentityInfo taskIdentityInfo,
        [out] TaskIdentity taskIdentity,
        [out] int resultCode
    );

    /**
     * @brief Revoke task identities.
     * @param taskIds List of task IDs to revoke.
     * @param resultCode Error code output (0 for success).
     */
    [ipccode 14] void RevokeTaskIdentity(
        [in] List<String> taskIds,
        [out] int resultCode
    );

    /**
     * @brief Retrieve auth token by task id.
     * @param callerToken Caller token id.
     * @param taskId Task id to retrieve auth token for.
     * @param authToken Output auth token bytes (empty for low-risk tasks).
     * @param resultCode Error code output (0 for success).
     */
    [ipccode 15] void RetrieveAuthTokenByTaskId(
        [in] int callerToken,
        [in] String taskId,
        [out] List<int> authToken,
        [out] int resultCode
    );

    /**
     * @brief Request ticket for CLI tools.
     * @param cliCmdInfos List of CLI command infos to query.
     * @param ticketOptions Ticket options (expire time, etc).
     * @param ticketQueryResult Result containing permission info and ticket (output parameter).
     * @param resultCode Error code output (0 for success).
     */
    [ipccode 10] void RequestToolTicket(
        [in] List<CommandInfo> cliCmdInfos,
        [in] TicketOptions ticketOptions,
        [out] TicketQueryResult ticketQueryResult,
        [out] int resultCode
    );

    /**
     * @brief Batch query command permissions.
     * @param cmds List of commands to query (input parameter).
     * @param cmdPermissions List of permission results (output parameter).
     * @param resultCode Error code output (0 for success).
     */
    [ipccode 500] void BatchQueryCommandPermission(
        [in] List<CommandInfo> cmds,
        [out] List<CommandPermissionInfo> cmdPermissions,
        [out] int resultCode
    );

    [ipccode 501] int RequestToolPermissions(
        [in] PermissionQuery permissionQuery,
        [out] PermissionQueryResult permissionQueryResult
    );

    [ipccode 502] int GrantToolPermissionsByUser(
        [in] List<UserAuthResult> userAuthResult,
        [out] List<VerifyTicketInfo> ticketInfo
    );

    /**
     * @brief Query static CLI command permissions with ATM auth status.
     * @param cmds List of CLI commands to query.
     * @param callerTokenId Caller token ID (0 = use IPC caller's token).
     * @param cmdPermissions List of permission results (output parameter).
     * @param resultCode Error code output (0 for success).
     */
    [ipccode 11] void QueryStaticCliCmdPermissions(
        [in] List<CommandInfo> cmds,
        [in] int callerTokenId,
        [out] List<CommandPermissionInfo> cmdPermissions,
        [out] int resultCode
    );

    /**
     * @brief Query the control status of simulated click operation.
     * @param appInfoList List of target application info to query (input parameter).
     * @param resultList List of control status results (output parameter).
     * @param resultCode Error code output (0 for success).
     */
    [ipccode 503] void QueryControlAppStatus(
        [in] List<AppInfo> appInfoList,
        [out] List<ControlAppStatusResult> resultList,
        [out] int resultCode
    );

    /**
     * @brief Check whether the caller app is allowed to control the target app.
     *
     * This IPC carries the first-time full-list fetch responsibility: the Service queries
     * the closed-source module for the full list of user-explicitly-denied app-pairs and
     * returns them. The inner SDK writes the list into the in-memory cache and then answers
     * individual decision queries from the cache (2ms path). Subsequent queries do not go
     * through this IPC.
     *
     * @param callerApp The caller app (A app) information.
     * @param targetApp The target app (B app) information.
     * @param deniedPairs Output full list of explicitly-denied app-pairs. Each entry is
     *                    serialized as "callerBundleName:callerIndex:targetBundleName:targetIndex".
     * @param resultCode Error code output (0 for success).
     */
    [ipccode 505] void CheckControlPermission(
        [in] AppInfo callerApp,
        [in] AppInfo targetApp,
        [out] List<String> deniedPairs,
        [out] int resultCode
    );

    /**
     * @brief Register a callback for component click decision by session ID.
     * @param sessionId The session ID used to identify the feedback channel.
     * @param remoteCallback The remote callback to be invoked when ReportComponentClickDecision is called.
     * @param resultCode Error code output (0 for success).
     */
    [ipccode 506] void RegisterComponentClickCallback(
        [in] long sessionId,
        [in] IRemoteObject remoteCallback,
        [out] int resultCode
    );

    /**
     * @brief Report component click decision.
     * @param sessionId The session ID identifying the feedback channel.
     * @param clickResult The component click decision result.
     * @param resultCode Error code output (0 for success).
     */
    [ipccode 507] void ReportComponentClickDecision(
        [in] long sessionId,
        [in] ComponentClickResult clickResult,
        [out] int resultCode
    );

    /**
     * @brief Unregister the callback and destroy the session by session ID.
     * @param sessionId The session ID.
     * @param resultCode Error code output (0 for success).
     */
    [ipccode 508] void UnregisterComponentClickCallback(
        [in] long sessionId,
        [out] int resultCode
    );

    /**
     * @brief Store operation record for simulated click control.
     * @param callerApp The caller app (A app) information.
     * @param targetApp The target app (B app) information.
     * @param decision The control decision result.
     * @param resultCode Error code output (0 for success).
     */
    [ipccode 509] void StoreOperationRecord(
        [in] AppInfo callerApp,
        [in] AppInfo targetApp,
        [in] ControlDecision decision,
        [out] int resultCode
    );

    /**
     * @brief Get the control dialog bundle name from the closed-source plugin.
     * @param bundleName Output bundle name of the control dialog UIExtensionAbility.
     * @param resultCode Error code output (0 for success).
     */
    [ipccode 510] void GetControlDialogBundleName(
        [out] String bundleName,
        [out] int resultCode
    );
};